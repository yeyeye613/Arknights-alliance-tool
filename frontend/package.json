{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "coverage": "vitest run --coverage",
    "knip": "knip",
    "verify": "npm run typecheck && npm run lint && npm run test:run && npm run knip",
    "codebook": "node scripts/gen-codebook.mjs"
  },
  "dependencies": {
    "pako": "^2.1.0",
    "vue": "^3.5.30",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.0",
    "@types/pako": "^2.0.4",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^15.15.0",
    "jsdom": "^29.0.1",
    "knip": "^6.46.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.0",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.2.5",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  }
}
